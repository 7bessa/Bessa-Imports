# =========================================================
# Bessa Imports — variáveis de ambiente
# =========================================================
# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" NUNCA deve ser commitado (já está no .gitignore).
#
# Em produção (Cloudflare Pages), essas chaves NÃO devem
# ficar em nenhum arquivo do repositório — configure-as em:
# Cloudflare Dashboard > seu projeto Pages > Settings >
# Environment variables. O .env é só para rodar localmente.
# =========================================================

# ----- Cloudflare -----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ----- Pagamentos (quando integrar checkout de verdade) -----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# ----- E-mail transacional (confirmação de pedido etc.) -----
RESEND_API_KEY=
SENDGRID_API_KEY=

# ----- WhatsApp Business API (se sair do link wa.me simples) -----
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ----- Banco de dados (se adicionar Cloudflare D1 ou outro) -----
DATABASE_URL=
